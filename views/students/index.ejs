<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Students - Attendance System</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    /* Make table responsive */
    .table-responsive {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }

    table {
      min-width: 700px; /* Prevents columns from crushing */
    }

    @media (max-width: 768px) {
      .page-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 15px;
      }

      th, td {
        padding: 10px 12px;
        font-size: 14px;
      }

      .btn {
        padding: 5px 10px !important;
        font-size: 12px !important;
      }
    }
  </style>
</head>
<body>

  <div class="navbar">
    <div class="brand">
      <i class="bi bi-mortarboard-fill"></i> Attendance System
    </div>
    <div class="nav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/attendance">Attendance</a>
      <a href="/auth/logout">Logout</a>
    </div>
  </div>

  <div class="container">
    <div class="page-header">
      <h1>All Students</h1>
      <a href="/students/add" class="btn btn-success">
        <i class="bi bi-plus-lg"></i> Add New Student
      </a>
    </div>

    <div class="card">
      <div class="table-responsive">
        <table>
          <thead>
            <tr>
              <th>Roll No</th>
              <th>Name</th>
              <th>Class</th>
              <th>Section</th>
              <th>Phone</th>
              <th>Parent Phone</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (students.length === 0) { %>
              <tr>
                <td colspan="7" style="text-align: center; padding: 40px; color: #65676b;">
                  No students found. Click "Add New Student" to begin.
                </td>
              </tr>
            <% } %>

            <% students.forEach(student => { %>
              <tr>
                <td><%= student.rollNumber %></td>
                <td><strong><%= student.name %></strong></td>
                <td><%= student.className %></td>
                <td><%= student.section || '-' %></td>
                <td><%= student.phone %></td>
                <td><%= student.parentPhone || '-' %></td>
                <td>
                  <a href="/students/edit/<%= student._id %>" class="btn btn-primary" style="padding: 6px 12px; font-size: 13px;">
                    Edit
                  </a>
                  <% if (user.role === 'admin' || user.role === 'teacher' || user.role === 'message_faculty') { %>
                    <form action="/students/delete/<%= student._id %>" method="POST" style="display:inline;">
                      <button type="submit" class="btn btn-danger" style="padding: 6px 12px; font-size: 13px;" onclick="return confirm('Are you sure you want to delete this student?')">
                        Delete
                      </button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</body>
</html>