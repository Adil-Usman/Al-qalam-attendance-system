<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Attendance History</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    .status-present {
      background: #d4edda;
      color: #155724;
      padding: 5px 14px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
    }
    .status-absent {
      background: #f8d7da;
      color: #721c24;
      padding: 5px 14px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
    }
    .status-not {
      background: #e2e3e5;
      color: #383d41;
      padding: 5px 14px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
    }
    .table-responsive {
      overflow-x: auto;
    }
  </style>
</head>
<body>

  <div class="navbar">
    <div class="brand">
      <i class="bi bi-mortarboard-fill"></i> Attendance System
    </div>
    <div class="nav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/attendance">Mark Attendance</a>
      <a href="/auth/logout">Logout</a>
    </div>
  </div>

  <div class="container">
    <div class="page-header">
      <h1><i class="bi bi-clock-history"></i> Attendance History</h1>
    </div>

    <!-- Filter Form -->
    <div class="card" style="max-width: 600px; margin-bottom: 25px;">
      <form action="/attendance/history/view" method="GET">
        <div class="form-group">
          <label>Select Class</label>
          <select name="className" required>
            <option value="">-- Select Class --</option>
            <% classes.forEach(c => { %>
              <option value="<%= c %>" <%= selectedClass === c ? 'selected' : '' %>><%= c %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label>Select Date</label>
          <input type="date" name="date" value="<%= selectedDate || '' %>" required>
        </div>

        <button type="submit" class="btn btn-primary" style="padding: 11px 24px;">
          <i class="bi bi-search"></i> View Attendance
        </button>
      </form>
    </div>

    <!-- Results -->
    <% if (records) { %>
      <div class="card">
        <h3 style="margin-bottom: 15px;">
          Class: <strong><%= selectedClass %></strong> &nbsp;|&nbsp; Date: <strong><%= selectedDate %></strong>
        </h3>

        <div class="table-responsive">
          <table>
            <thead>
              <tr>
                <th>Roll No</th>
                <th>Student Name</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% records.forEach(item => { %>
                <tr>
                  <td><%= item.student.rollNumber %></td>
                  <td><strong><%= item.student.name %></strong></td>
                  <td>
                    <% if (item.status === 'Present') { %>
                      <span class="status-present">Present</span>
                    <% } else if (item.status === 'Absent') { %>
                      <span class="status-absent">Absent</span>
                    <% } else { %>
                      <span class="status-not">Not Marked</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>

</body>
</html>