<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mark Attendance - Attendance System</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>

  <div class="navbar">
    <div class="brand">
      <i class="bi bi-mortarboard-fill"></i> Attendance System
    </div>
    <div class="nav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/students">Students</a>
      <a href="/auth/logout">Logout</a>
    </div>
  </div>

  <div class="container">
    <div class="page-header">
      <h1>Mark Attendance</h1>
    </div>

    <div class="card" style="max-width: 520px;">
      <% if (typeof success !== 'undefined') { %>
        <div style="background: #d4edda; color: #155724; padding: 12px 16px; border-radius: 8px; margin-bottom: 20px;">
          <i class="bi bi-check-circle-fill"></i> Attendance saved successfully!
        </div>
      <% } %>

      <form action="/attendance/mark" method="GET">
        <div class="form-group">
          <label>Select Class</label>
          <select name="className" required>
            <option value="">-- Select Class --</option>
            <% classes.forEach(c => { %>
              <option value="<%= c %>"><%= c %></option>
            <% }) %>
          </select>
        </div>

        <div class="form-group">
          <label>Select Date</label>
          <input type="date" name="date" required value="<%= new Date().toISOString().split('T')[0] %>">
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 13px; font-size: 16px;">
          Continue <i class="bi bi-arrow-right"></i>
        </button>
      </form>
    </div>
  </div>

</body>
</html>