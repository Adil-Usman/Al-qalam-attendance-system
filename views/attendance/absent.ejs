<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Absent Students - WhatsApp</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    .table-responsive {
      width: 100%;
      overflow-x: auto;
    }
    table {
      min-width: 800px;
    }
    .pending-row {
      background-color: #fff8e6;
    }
    .sent-row {
      background-color: #f0fdf4;
    }
  </style>
</head>
<body>

  <div class="navbar">
    <div class="brand">
      <i class="bi bi-mortarboard-fill"></i> Attendance System
    </div>
    <div class="nav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/auth/logout">Logout</a>
    </div>
  </div>

  <div class="container">
    <div class="page-header">
      <h1><i class="bi bi-whatsapp"></i> Absent Students</h1>
    </div>

    <div class="card">
      <!-- Date Filter -->
      <form method="GET" action="/absent" style="margin-bottom: 20px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
        <label style="font-weight: 600;">Select Date:</label>
        <input type="date" name="date" value="<%= selectedDate %>" onchange="this.form.submit()" style="width: auto; padding: 8px 12px;">
      </form>

      <div style="margin-bottom: 15px; font-size: 16px;">
        Total Absent: <strong><%= absents.length %></strong>
      </div>

      <div class="table-responsive">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th>Student Name</th>
              <th>Class</th>
              <th>Phone</th>
              <th>Parent Phone</th>
              <th>WhatsApp</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% if (absents.length === 0) { %>
              <tr>
                <td colspan="7" style="text-align: center; padding: 40px; color: #65676b;">
                  No absent students on this date.
                </td>
              </tr>
            <% } %>

            <% absents.forEach((record, index) => { 
                 const student = record.student;
                 if (!student) return;

                 // Prefer parent phone, otherwise student phone
                 const phone = student.parentPhone || student.phone || '';
                 const cleanPhone = phone.replace(/[^0-9]/g, '');
                 const whatsappNumber = cleanPhone.startsWith('92') ? cleanPhone : 
                                        cleanPhone.startsWith('0') ? '92' + cleanPhone.slice(1) : 
                                        cleanPhone ? '92' + cleanPhone : '';

                 const message = `Assalam o Alaikum,\n\nYour child ${student.name} was marked ABSENT today (${selectedDate}).\n\nPlease contact the class teacher if this is a mistake or if you need any information.\n\nThank you.\nAl-Qalam Academy`;
                 const whatsappLink = whatsappNumber ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(message)}` : '#';
            %>
              <tr class="<%= record.messageSent ? 'sent-row' : 'pending-row' %>">
                <td><%= index + 1 %></td>
                <td><strong><%= student.name %></strong></td>
                <td><%= student.className %> <%= student.section || '' %></td>
                <td><%= student.phone || '-' %></td>
                <td><%= student.parentPhone || '-' %></td>
                <td>
                  <% if (whatsappNumber) { %>
                    <a href="<%= whatsappLink %>" target="_blank" class="btn btn-whatsapp" style="padding: 7px 14px; font-size: 13px;">
                      <i class="bi bi-whatsapp"></i> Open WhatsApp
                    </a>
                  <% } else { %>
                    <span style="color: #999;">No number</span>
                  <% } %>
                </td>
                <td>
                  <% if (record.messageSent) { %>
                    <span class="badge badge-sent">
                      <i class="bi bi-check-circle"></i> Sent
                    </span>
                  <% } else { %>
                    <form action="/absent/mark-sent/<%= record._id %>" method="POST" style="display:inline;">
                      <input type="hidden" name="date" value="<%= selectedDate %>">
                      <button type="submit" class="btn btn-primary" style="padding: 6px 12px; font-size: 13px;">
                        Mark as Sent
                      </button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</body>
</html>