<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Progress - Parents</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    .status-present {
      background: #d4edda;
      color: #155724;
      padding: 5px 14px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
    }
    .status-absent {
      background: #f8d7da;
      color: #721c24;
      padding: 5px 14px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
    }
    .status-not {
      background: #e2e3e5;
      color: #383d41;
      padding: 5px 14px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
    }
    .info-box {
      background: #f8f9fa;
      padding: 18px;
      border-radius: 10px;
      margin-bottom: 20px;
    }
  </style>
</head>
<body>

  <div class="navbar">
    <div class="brand">
      <i class="bi bi-mortarboard-fill"></i> Attendance System
    </div>
    <div class="nav-links">
      <a href="/auth/login">Staff Login</a>
    </div>
  </div>

  <div class="container">
    <div class="page-header">
      <h1><i class="bi bi-person-lines-fill"></i> Check Student Progress</h1>
    </div>

    <!-- Search Form -->
    <div class="card" style="max-width: 550px; margin-bottom: 30px;">
      <h3 style="margin-bottom: 15px;">Search Student</h3>

      <% if (error) { %>
        <div style="background: #f8d7da; color: #721c24; padding: 12px 16px; border-radius: 8px; margin-bottom: 18px; font-size: 14px;">
          <i class="bi bi-exclamation-circle-fill"></i> <%= error %>
        </div>
      <% } %>

      <form action="/parents/search" method="POST">
        <div class="form-group">
          <label>Roll Number</label>
          <input type="text" name="rollNumber" placeholder="Enter Roll Number" required>
        </div>

        <div class="form-group">
          <label>Class</label>
          <input type="text" name="className" placeholder="Example: 10" required>
        </div>

        <button type="submit" class="btn btn-primary" style="padding: 12px 24px;">
          <i class="bi bi-search"></i> View Progress
        </button>
      </form>
    </div>

    <!-- Result -->
    <% if (student) { %>
      <div class="card">
        <h3 style="margin-bottom: 15px;">Student Information</h3>

        <div class="info-box">
          <p><strong>Name:</strong> <%= student.name %></p>
          <p><strong>Roll Number:</strong> <%= student.rollNumber %></p>
          <p><strong>Class:</strong> <%= student.className %> <%= student.section || '' %></p>
        </div>

        <h3 style="margin: 25px 0 15px;">Last 7 Days Attendance</h3>

        <div class="table-responsive">
          <table>
            <thead>
              <tr>
                <th>Date</th>
                <th>Day</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% records.forEach(record => { %>
                <tr>
                  <td><%= record.date %></td>
                  <td><%= record.day %></td>
                  <td>
                    <% if (record.status === 'Present') { %>
                      <span class="status-present">Present</span>
                    <% } else if (record.status === 'Absent') { %>
                      <span class="status-absent">Absent</span>
                    <% } else { %>
                      <span class="status-not">Not Marked</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>

</body>
</html>