<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register - Attendance System</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    /* Extra compact styles only for register */
    .auth-form-box {
      padding: 30px 32px;
    }
    .auth-form-box h2 {
      font-size: 24px;
      margin-bottom: 4px;
    }
    .auth-form-box .subtitle {
      margin-bottom: 18px;
      font-size: 14px;
    }
    .auth-form-box .form-group {
      margin-bottom: 12px;
    }
    .auth-form-box input,
    .auth-form-box select {
      padding: 10px 13px;
      font-size: 14px;
    }
    .auth-form-box button {
      padding: 11px;
      margin-top: 6px;
      font-size: 15px;
    }
    .auth-form-box .bottom-link {
      margin-top: 16px;
      font-size: 14px;
    }
    .auth-left h1 {
      font-size: 30px;
    }
    .auth-left p {
      font-size: 15px;
    }
    .auth-left .logo {
      font-size: 55px;
      margin-bottom: 15px;
    }
  </style>
</head>
<body>

  <div class="auth-split">
    <!-- Left Side -->
    <div class="auth-left">
      <div class="logo">
        <i class="bi bi-person-plus-fill"></i>
      </div>
      <h1>Create Account</h1>
      <p>Only authorized staff can register using the secret code.</p>
    </div>

  <!-- Right Side -->
<div class="auth-right">
  <div class="auth-form-box">
    <h2>Sign Up</h2>
    <p class="subtitle">Create your staff account</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div style="background: #f8d7da; color: #721c24; padding: 12px 16px; border-radius: 8px; margin-bottom: 18px; font-size: 14px; border: 1px solid #f5c6cb;">
        <i class="bi bi-exclamation-circle-fill"></i> <%= error %>
      </div>
    <% } %>

    <form action="/auth/register" method="POST">
      <div class="form-group">
        <label>Full Name</label>
        <input type="text" name="name" placeholder="Enter full name" required>
      </div>

      <div class="form-group">
        <label>Email Address</label>
        <input type="email" name="email" placeholder="Enter email" required>
      </div>

      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" placeholder="Create password" required>
      </div>

      <div class="form-group">
        <label>Role</label>
        <select name="role" required>
          <option value="">Select Role</option>
          <option value="teacher">Teacher</option>
          <option value="message_faculty">Message Faculty</option>
          <option value="admin">Admin</option>
        </select>
      </div>

      <div class="form-group">
        <label>Secret Code</label>
        <input type="text" name="secret" placeholder="Enter secret code" required>
      </div>

      <button type="submit">Create Account</button>
    </form>

    <a href="/auth/login" class="bottom-link">Already have an account? Login</a>
  </div>
</div>

</body>
</html>